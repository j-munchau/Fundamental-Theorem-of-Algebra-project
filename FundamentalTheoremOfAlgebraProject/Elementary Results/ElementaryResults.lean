import Mathlib.Algebra.Polynomial.Basic
import Mathlib.Algebra.Polynomial.Monic
import Mathlib.Algebra.Polynomial.SpecificDegree
import Mathlib.FieldTheory.RatFunc.IntermediateField
import Mathlib.FieldTheory.Minpoly.Basic
import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic
import FundamentalTheoremOfAlgebraProject.TheoremStatement.OurRealClosedField

/-!
# Elementary properties of the extension R(i)/R

Let `R` be a real closed field and `C/R` a field extension generated by an element `i : C` such
that `i ^ 2 = -1`.

We show that the minimal polynomial of `i` over `R` is `X ^ 2 + 1`, that the degree of the field
extension `C/R` is two, and that `{1, i}` is an `R`-basis of `C`. Consequently, every element of
`C` can be written uniquely in the form `a + bi` for `a b : R`.

## Main definitions

* `polyI`: The polynomial `X ^ 2 + 1`.
* `complexPowerBasis`: The power basis of `C` generated by `i`.
* `complexBasis`: The `R`-basis `{1, i}` of `C`.

## Main results

* `polyI_irreducible`: The polynomial `X ^ 2 + 1 : R[X]` is irreducible.
* `minpoly_i`: The minimal polynomial of `i` over `R` is `X ^ 2 + 1`.
* `complex_extension_finrank`: The field extension `C/R` has degree two.
* `complexRepresentation`: Every element of `C` can be written in the form `a + bi` for some
  `a b : R`.
* `complexRepresentation_unique`: The representation of an element of `C` in the form `a + bi` for
  some `a b : R` is unique.
-/

open Polynomial
open scoped Polynomial

/-!
### Properties of the polynomial `X ^ 2 + 1`

We establish the basic properties of `X ^ 2 + 1` needed to show that it is the minimal
polynomial of `i` over `R`. In particular, we show that `X ^ 2 + 1` is irreducible when
`R` is a real closed field.
-/

/--
The polynomial `X ^ 2 + 1 : R[X]` for a field `R`.
-/
noncomputable def polyI (R : Type*) [Field R] : R[X] :=
  X ^ 2 + 1

variable {R : Type*} [Field R]

lemma polyI_monic : (polyI R).Monic := by
  have h : (2 : ℕ) ≠ 0 := by decide
  exact monic_X_pow_add_C (1 : R) (n := 2) h

lemma polyI_nonzero : polyI R ≠ 0 := by
  exact polyI_monic.ne_zero

lemma polyI_natDegree : (polyI R).natDegree = 2 := by
  unfold polyI
  simp

/--
The polynomial `X ^ 2 + 1 : R[X]` has no roots when `R` is a real closed field, since
`-1` is not a square.
-/
lemma polyI_no_root [OurRealClosedField R] : ∀ a : R,
      ¬(polyI R).IsRoot a := by
  intro a ha
  -- Rewrite `ha` as `a ^ 2 + 1 = 0`.
  simp only [polyI, Polynomial.IsRoot.def, eval_add, eval_pow, eval_X, eval_one] at ha
  apply eq_neg_of_add_eq_zero_left (a := a ^ 2) (b := 1) at ha
  exact square_ne_minus_one a ha

/--
The polynomial `X ^ 2 + 1 : R[X]` is irreducible when `R` is a real closed field, since
it has no roots and is of degree two.
-/
lemma polyI_irreducible [OurRealClosedField R]
      : Irreducible (polyI R) := by
  -- The irreducibility criterion requires the degree to be between one and three.
  have hdeg : (polyI R).natDegree ∈ Finset.Icc 1 3 := by
    rw [polyI_natDegree]
    decide
  exact irreducible_of_degree_le_three_of_not_isRoot hdeg (polyI_no_root)

/-!
### Minimal polynomial of `i` and degree of `C/R`

Since `i` is a root of the monic and irreducible polynomial `X ^ 2 + 1 : R[X]`, it is integral
over `R`, and `X ^ 2 + 1` is the minimal polynomial of `i` over `R`.

In particular, `[C : R] = deg(X ^ 2 + 1) = 2`.
-/

open scoped IntermediateField

variable {C : Type*} [Field C] [Algebra R C]

variable {i : C}

lemma i_isRoot_polyI (sq : i ^ 2 = -1) : aeval i (polyI R) = 0 := by
  unfold polyI
  simp only [map_add, map_pow, aeval_X, map_one]
  rw [sq, neg_add_cancel]

/--
Suppose `C` is a field extension of `R` and `i : C` is an element satisfying `i ^ 2 = -1`. Then
`i` is integral over `R`.
-/
lemma i_isIntegral (sq : i ^ 2 = -1) : IsIntegral R i := by
  use polyI R
  constructor
  · exact polyI_monic
  · rw [← Polynomial.aeval_def]
    exact i_isRoot_polyI sq

/--
Suppose `C` is a field extension of a real closed field `R` and `i : C` is an element satisfying
`i ^ 2 = -1`. Then the minimal polynomial of `i` over `R` is `X ^ 2 + 1`, since `X ^ 2 + 1` is
monic, irreducible and has `i` as a root.
-/
lemma minpoly_i [OurRealClosedField R] (sq : i ^ 2 = -1) : minpoly R i = polyI R := by
  exact ((minpoly.eq_iff_aeval_eq_zero polyI_irreducible polyI_monic).mpr (i_isRoot_polyI sq)).symm

/--
Suppose `C` is a field extension of a real closed field `R` generated by an element `i : C`
satisfying `i ^ 2 = -1`. Then `[C : R] = 2`.
-/
lemma complex_extension_finrank [OurRealClosedField R] (sq : i ^ 2 = -1) (gen : R⟮i⟯ = ⊤)
      : Module.finrank R C = 2 := by
  -- Introduce a local fact that the degree of `R⟮i⟯` over `R` is equal to the degree of the
  -- minimal polynomial of `i`.
  have h := IntermediateField.adjoin.finrank (i_isIntegral (R := R) sq)
  -- Identify `R⟮i⟯` with `C` and the minimal polynomial of `i` with `polyI`.
  rw [gen, IntermediateField.finrank_top', minpoly_i sq, polyI_natDegree] at h
  exact h

lemma complex_extension_finiteDimensional [OurRealClosedField R] (sq : i ^ 2 = -1) (gen : R⟮i⟯ = ⊤)
      : FiniteDimensional R C := by
  -- `Module.finrank` is zero for infinite-dimensional vector spaces so it suffices to show that
  -- `Module.finrank R C` is positive.
  apply FiniteDimensional.of_finrank_pos
  rw [complex_extension_finrank sq gen]
  exact Nat.zero_lt_two

/-!
### Construction of an `R`-basis of `C`

Since `C` is generated over `R` by the integral element `i` and the minimal polynomial of `i` over
`R` has degree two, the power basis generated by `i` has underlying basis `{1, i}`.
-/

/--
The power basis of `C` over `R` generated by `i`.
-/
noncomputable def complexPowerBasis [OurRealClosedField R] (sq : i ^ 2 = -1)
                  (gen : R⟮i⟯ = ⊤) : PowerBasis R C :=
  PowerBasis.ofAdjoinSimpleEqTop (i_isIntegral sq) gen

lemma complexPowerBasis_dim [OurRealClosedField R] (sq : i ^ 2 = -1)
      (gen : R⟮i⟯ = ⊤) : (complexPowerBasis sq gen).dim = 2 := by
  simp [complexPowerBasis, minpoly_i sq, polyI_natDegree]

/--
The `R`-basis `{1, i}` of `C` indexed by `Fin 2`.

The underlying basis of `complexPowerBasis sq gen` is indexed by
`Fin (complexPowerBasis sq gen).dim`. We reindex this basis using the equivalence induced by
`(complexPowerBasis sq gen).dim = 2`.
-/
noncomputable def complexBasis [OurRealClosedField R] (sq : i ^ 2 = -1)
                  (gen : R⟮i⟯ = ⊤) : Module.Basis (Fin 2) R C :=
  (complexPowerBasis sq gen).basis.reindex (finCongr (complexPowerBasis_dim sq gen))

/--
The reindexed basis retains the defining property of the power basis, namely that its `j`-th
basis element is `i ^ j`.
-/
lemma complexBasis_eq_pow [OurRealClosedField R] (sq : i ^ 2 = -1)
      (gen : R⟮i⟯ = ⊤) (j : Fin 2)
      : complexBasis sq gen j = i ^ (j : ℕ) := by
  -- Introduce local abbreviations for the power basis and the equivalence of indexing types.
  let P := complexPowerBasis sq gen
  let e := finCongr (complexPowerBasis_dim sq gen)
  -- Express `complexBasis` in terms of the reindexed `P.basis` so that reindexing and power basis
  -- lemmas can be applied.
  change (P.basis.reindex e) j = i ^ (j : ℕ)
  rw [Module.Basis.reindex_apply, PowerBasis.basis_eq_pow]
  -- The generator of `P` is definitionally equal to `i` and the underlying natural number of
  -- `e.symm j` is definitionally equal to the underlying natural number of `j`.
  change i ^ (j : ℕ) = i ^ (j : ℕ)
  rfl

lemma complexBasis_zero [OurRealClosedField R] (sq : i ^ 2 = -1)
      (gen : R⟮i⟯ = ⊤) : complexBasis sq gen 0 = 1 := by
  rw [complexBasis_eq_pow]
  simp

lemma complexBasis_one [OurRealClosedField R] (sq : i ^ 2 = -1)
      (gen : R⟮i⟯ = ⊤) : complexBasis sq gen 1 = i := by
  rw [complexBasis_eq_pow]
  simp

/-!
### Representation of elements of `C`

We show the existence and uniqueness of representations of elements of `C` of the form `a + bi`
for `a b : R`. This follows from the fact that `{1, i}` is an `R`-basis of `C`.
-/

/--
Every element of `C` can be expressed in the form `a + bi` for `a b : R`.
-/
lemma complexRepresentation [OurRealClosedField R] (sq : i ^ 2 = -1)
      (gen : R⟮i⟯ = ⊤) (z : C) : ∃ (a b : R), z = a • 1 + b • i := by
  let B := complexBasis sq gen
  -- Provide the coordinates of `z` with respect to the basis `B` as witnesses.
  refine ⟨B.repr z 0, B.repr z 1, ?_⟩
  -- Apply the basis expansion formula and substitute the basis elements `1` and `i`.
  simpa only [B, Fin.sum_univ_two, complexBasis_zero sq gen, complexBasis_one sq gen,
             Algebra.smul_def, mul_one] using (B.sum_repr z).symm

/--
The representation of an element of `C` of the form `a + bi` for `a b : R` is unique.
-/
lemma complexRepresentation_unique [OurRealClosedField R] (sq : i ^ 2 = -1)
      (gen : R⟮i⟯ = ⊤) (a b c d : R)
      (h : a • 1 + b • i = c • 1 + d • i)
      : a = c ∧ b = d := by
  let B := complexBasis sq gen
  -- Define the coordinate functions corresponding to the given representations.
  let c1 : Fin 2 → R := ![a, b]
  let c2 : Fin 2 → R := ![c, d]
  -- Introduce a hypothesis equivalent to `h` but reformulated as an equality of indexed
  -- linear combinations so that we may apply linear independence.
  have he : ∑ j, c1 j • B j = ∑ j, c2 j • B j := by
    simpa [B, c1, c2, Fin.sum_univ_two, complexBasis_zero sq gen, complexBasis_one sq gen,
          Algebra.smul_def, mul_one] using h
  -- Apply linear independence of `B` to the equality of linear combinations.
  have hf := B.linearIndependent.eq_coords_of_eq he
  exact ⟨hf 0, hf 1⟩
